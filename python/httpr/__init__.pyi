from __future__ import annotations

import datetime
from typing import (
    Any,
    AsyncIterator,
    Iterator,
    Mapping,
    Optional,
    Sequence,
    Tuple,
    Union,
)

__version__: str

class HTTPError(Exception):
    request: Optional[Request]

class RequestError(HTTPError): ...
class TransportError(RequestError): ...
class TimeoutException(TransportError): ...
class ConnectTimeout(TimeoutException): ...
class ReadTimeout(TimeoutException): ...
class WriteTimeout(TimeoutException): ...
class PoolTimeout(TimeoutException): ...
class NetworkError(TransportError): ...
class ConnectError(NetworkError): ...
class ReadError(NetworkError): ...
class WriteError(NetworkError): ...
class CloseError(NetworkError): ...
class ProtocolError(TransportError): ...
class LocalProtocolError(ProtocolError): ...
class RemoteProtocolError(ProtocolError): ...
class ProxyError(TransportError): ...
class UnsupportedProtocol(TransportError): ...
class DecodingError(RequestError): ...
class TooManyRedirects(RequestError): ...

class HTTPStatusError(HTTPError):
    response: Response

class InvalidURL(Exception): ...
class StreamError(RuntimeError): ...

HeaderTypes = Union[Headers, Mapping[str, str], Sequence[Tuple[str, str]]]
QueryParamTypes = Union[Mapping[str, Any], Sequence[Tuple[str, Any]]]
CookieTypes = Union[Cookies, Mapping[str, str], Sequence[Tuple[str, str]]]
AuthTypes = Union[Tuple[str, str], BasicAuth, DigestAuth, BearerAuth]
TimeoutTypes = Union[float, int, None, Timeout]
ProxyTypes = Union[str, Mapping[str, Optional[str]]]
VerifyTypes = Union[bool, str]
CertTypes = Union[str, Tuple[str, str]]
URLTypes = Union[str, URL]

class Headers:
    def __init__(self, headers: Optional[HeaderTypes] = None, encoding: str = "utf-8") -> None: ...
    def get(self, key: str, default: Optional[str] = None) -> Optional[str]: ...
    def get_list(self, key: str, split_commas: bool = False) -> list[str]: ...
    def keys(self) -> list[str]: ...
    def values(self) -> list[str]: ...
    def items(self) -> list[tuple[str, str]]: ...
    def multi_items(self) -> list[tuple[str, str]]: ...
    def update(self, headers: HeaderTypes) -> None: ...
    def copy(self) -> Headers: ...
    def __getitem__(self, key: str) -> str: ...
    def __setitem__(self, key: str, value: str) -> None: ...
    def __delitem__(self, key: str) -> None: ...
    def __contains__(self, key: str) -> bool: ...
    def __len__(self) -> int: ...
    def __iter__(self) -> Iterator[str]: ...

class Cookies:
    def __init__(self, cookies: Optional[CookieTypes] = None) -> None: ...
    def set(self, name: str, value: str, domain: Optional[str] = None, path: Optional[str] = "/") -> None: ...
    def get(self, name: str, default: Optional[str] = None, domain: Optional[str] = None, path: Optional[str] = None) -> Optional[str]: ...
    def delete(self, name: str, domain: Optional[str] = None, path: Optional[str] = None) -> None: ...
    def clear(self, domain: Optional[str] = None, path: Optional[str] = None) -> None: ...
    def items(self) -> list[tuple[str, str]]: ...
    def keys(self) -> list[str]: ...
    def values(self) -> list[str]: ...
    def __getitem__(self, key: str) -> str: ...
    def __setitem__(self, key: str, value: str) -> None: ...
    def __delitem__(self, key: str) -> None: ...
    def __contains__(self, key: str) -> bool: ...
    def __len__(self) -> int: ...
    def __iter__(self) -> Iterator[str]: ...

class URL:
    def __init__(self, url: str) -> None: ...
    @property
    def scheme(self) -> str: ...
    @property
    def host(self) -> str: ...
    @property
    def port(self) -> Optional[int]: ...
    @property
    def path(self) -> str: ...
    @property
    def raw_path(self) -> bytes: ...
    @property
    def query(self) -> bytes: ...
    @property
    def fragment(self) -> str: ...
    @property
    def username(self) -> str: ...
    @property
    def password(self) -> Optional[str]: ...
    @property
    def netloc(self) -> bytes: ...
    def join(self, url: str) -> URL: ...

class Timeout:
    def __init__(
        self,
        timeout: Optional[float] = 5.0,
        *,
        connect: Optional[float] = None,
        read: Optional[float] = None,
        write: Optional[float] = None,
        pool: Optional[float] = None,
    ) -> None: ...
    @property
    def connect(self) -> Optional[float]: ...
    @property
    def read(self) -> Optional[float]: ...
    @property
    def write(self) -> Optional[float]: ...
    @property
    def pool(self) -> Optional[float]: ...

class Limits:
    def __init__(
        self,
        *,
        max_connections: Optional[int] = 100,
        max_keepalive_connections: Optional[int] = 20,
        keepalive_expiry: Optional[float] = 5.0,
    ) -> None: ...
    @property
    def max_connections(self) -> Optional[int]: ...
    @property
    def max_keepalive_connections(self) -> Optional[int]: ...
    @property
    def keepalive_expiry(self) -> Optional[float]: ...

class BasicAuth:
    def __init__(self, username: str, password: str) -> None: ...

class DigestAuth:
    def __init__(self, username: str, password: str) -> None: ...

class BearerAuth:
    def __init__(self, token: str) -> None: ...

class Request:
    def __init__(
        self,
        method: str,
        url: URLTypes,
        *,
        params: Optional[QueryParamTypes] = None,
        headers: Optional[HeaderTypes] = None,
        cookies: Optional[CookieTypes] = None,
        content: Any = None,
        data: Any = None,
        files: Any = None,
        json: Any = None,
        extensions: Optional[Mapping[str, Any]] = None,
    ) -> None: ...
    @property
    def method(self) -> str: ...
    @property
    def url(self) -> URL: ...
    @property
    def headers(self) -> Headers: ...
    @property
    def content(self) -> bytes: ...
    def read(self) -> bytes: ...

class Response:
    @property
    def status_code(self) -> int: ...
    @property
    def reason_phrase(self) -> str: ...
    @property
    def headers(self) -> Headers: ...
    @property
    def cookies(self) -> Cookies: ...
    @property
    def url(self) -> URL: ...
    @property
    def http_version(self) -> str: ...
    @property
    def elapsed(self) -> datetime.timedelta: ...
    @property
    def encoding(self) -> str: ...
    @encoding.setter
    def encoding(self, value: str) -> None: ...
    @property
    def content(self) -> bytes: ...
    @property
    def text(self) -> str: ...
    def json(self, **kwargs: Any) -> Any: ...
    @property
    def is_informational(self) -> bool: ...
    @property
    def is_success(self) -> bool: ...
    @property
    def is_redirect(self) -> bool: ...
    @property
    def is_client_error(self) -> bool: ...
    @property
    def is_server_error(self) -> bool: ...
    @property
    def is_error(self) -> bool: ...
    @property
    def is_stream_consumed(self) -> bool: ...
    @property
    def is_closed(self) -> bool: ...
    @property
    def num_bytes_downloaded(self) -> int: ...
    @property
    def request(self) -> Optional[Request]: ...
    @property
    def history(self) -> list[Response]: ...
    def raise_for_status(self) -> Response: ...
    def read(self) -> bytes: ...
    async def aread(self) -> bytes: ...
    def close(self) -> None: ...
    async def aclose(self) -> None: ...
    def iter_bytes(self, chunk_size: Optional[int] = None) -> Iterator[bytes]: ...
    def iter_raw(self, chunk_size: Optional[int] = None) -> Iterator[bytes]: ...
    def iter_text(self, chunk_size: Optional[int] = None) -> Iterator[str]: ...
    def iter_lines(self) -> Iterator[str]: ...
    def aiter_bytes(self, chunk_size: Optional[int] = None) -> AsyncIterator[bytes]: ...
    def aiter_raw(self, chunk_size: Optional[int] = None) -> AsyncIterator[bytes]: ...
    def aiter_text(self, chunk_size: Optional[int] = None) -> AsyncIterator[str]: ...
    def aiter_lines(self) -> AsyncIterator[str]: ...

class SyncStreamContext:
    def __enter__(self) -> Response: ...
    def __exit__(self, *args: Any) -> bool: ...

class AsyncStreamContext:
    async def __aenter__(self) -> Response: ...
    async def __aexit__(self, *args: Any) -> bool: ...

class Client:
    def __init__(
        self,
        *,
        auth: Optional[AuthTypes] = None,
        params: Optional[QueryParamTypes] = None,
        headers: Optional[HeaderTypes] = None,
        cookies: Optional[CookieTypes] = None,
        verify: Optional[VerifyTypes] = None,
        cert: Optional[CertTypes] = None,
        http2: bool = False,
        proxies: Optional[ProxyTypes] = None,
        timeout: TimeoutTypes = 5.0,
        follow_redirects: bool = False,
        limits: Optional[Limits] = None,
        max_redirects: int = 20,
        base_url: Optional[URLTypes] = None,
        trust_env: bool = True,
        retries: int = 0,
        http2_prior_knowledge: bool = False,
    ) -> None: ...
    @property
    def is_closed(self) -> bool: ...
    @property
    def headers(self) -> Headers: ...
    @property
    def cookies(self) -> Cookies: ...
    @property
    def base_url(self) -> Optional[URL]: ...
    @property
    def timeout(self) -> Timeout: ...
    def close(self) -> None: ...
    def __enter__(self) -> Client: ...
    def __exit__(self, *args: Any) -> bool: ...
    def build_request(self, method: str, url: URLTypes, **kwargs: Any) -> Request: ...
    def send(self, request: Request, *, stream: bool = False, auth: Optional[AuthTypes] = None, follow_redirects: Optional[bool] = None) -> Response: ...
    def request(self, method: str, url: URLTypes, **kwargs: Any) -> Response: ...
    def stream(self, method: str, url: URLTypes, **kwargs: Any) -> SyncStreamContext: ...
    def get(self, url: URLTypes, **kwargs: Any) -> Response: ...
    def post(self, url: URLTypes, **kwargs: Any) -> Response: ...
    def put(self, url: URLTypes, **kwargs: Any) -> Response: ...
    def patch(self, url: URLTypes, **kwargs: Any) -> Response: ...
    def delete(self, url: URLTypes, **kwargs: Any) -> Response: ...
    def head(self, url: URLTypes, **kwargs: Any) -> Response: ...
    def options(self, url: URLTypes, **kwargs: Any) -> Response: ...

class AsyncClient:
    def __init__(
        self,
        *,
        auth: Optional[AuthTypes] = None,
        params: Optional[QueryParamTypes] = None,
        headers: Optional[HeaderTypes] = None,
        cookies: Optional[CookieTypes] = None,
        verify: Optional[VerifyTypes] = None,
        cert: Optional[CertTypes] = None,
        http2: bool = False,
        proxies: Optional[ProxyTypes] = None,
        timeout: TimeoutTypes = 5.0,
        follow_redirects: bool = False,
        limits: Optional[Limits] = None,
        max_redirects: int = 20,
        base_url: Optional[URLTypes] = None,
        trust_env: bool = True,
        retries: int = 0,
        http2_prior_knowledge: bool = False,
    ) -> None: ...
    @property
    def is_closed(self) -> bool: ...
    @property
    def headers(self) -> Headers: ...
    @property
    def cookies(self) -> Cookies: ...
    @property
    def base_url(self) -> Optional[URL]: ...
    @property
    def timeout(self) -> Timeout: ...
    async def aclose(self) -> None: ...
    async def __aenter__(self) -> AsyncClient: ...
    async def __aexit__(self, *args: Any) -> bool: ...
    def build_request(self, method: str, url: URLTypes, **kwargs: Any) -> Request: ...
    async def send(self, request: Request, *, stream: bool = False, auth: Optional[AuthTypes] = None, follow_redirects: Optional[bool] = None) -> Response: ...
    async def request(self, method: str, url: URLTypes, **kwargs: Any) -> Response: ...
    def stream(self, method: str, url: URLTypes, **kwargs: Any) -> AsyncStreamContext: ...
    async def get(self, url: URLTypes, **kwargs: Any) -> Response: ...
    async def post(self, url: URLTypes, **kwargs: Any) -> Response: ...
    async def put(self, url: URLTypes, **kwargs: Any) -> Response: ...
    async def patch(self, url: URLTypes, **kwargs: Any) -> Response: ...
    async def delete(self, url: URLTypes, **kwargs: Any) -> Response: ...
    async def head(self, url: URLTypes, **kwargs: Any) -> Response: ...
    async def options(self, url: URLTypes, **kwargs: Any) -> Response: ...

def request(method: str, url: URLTypes, **kwargs: Any) -> Response: ...
def stream(method: str, url: URLTypes, **kwargs: Any) -> SyncStreamContext: ...
def get(url: URLTypes, **kwargs: Any) -> Response: ...
def post(url: URLTypes, **kwargs: Any) -> Response: ...
def put(url: URLTypes, **kwargs: Any) -> Response: ...
def patch(url: URLTypes, **kwargs: Any) -> Response: ...
def delete(url: URLTypes, **kwargs: Any) -> Response: ...
def head(url: URLTypes, **kwargs: Any) -> Response: ...
def options(url: URLTypes, **kwargs: Any) -> Response: ...
